{
  "name": "stock-analyze",
  "private": true,
  "version": "1.21.1",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "lightweight-charts": "^4.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.stock-analyze.app",
    "productName": "Stock Analyze",
    "directories": {
      "output": "../dist-electron-namuh"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "extraResources": [
      {
        "from": "../backend.exe",
        "to": "backend.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "description": "NAMUH PLUG stock dashboard",
  "author": "June"
}
